__pycache__/
*.pyc
.venv/


# Any Firebase/service-account key, whatever it's named (people don't always use the suggested
# name — e.g. "SAK.json", or the console's own default like "reliops-75ba9-firebase-adminsdk-....json"):
*.json
# ...except the hand-label answer keys, which hold no secrets
!backend/audit_keys/*.json

# Windows download markers that appear next to files copied from Windows into WSL
*:Zone.Identifier

